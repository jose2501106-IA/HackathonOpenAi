{
  // GitHub Codespaces: terminal en la nube con Node 22, Python, Codex CLI, Vercel CLI, GitHub CLI y Claude Code.
  // Paquetes verificados en npm el 2026-11-06: @openai/codex 0.167.0 y vercel 65.12.1.
  // Feature de Claude Code: la oficial de Anthropic (documentación de Claude Code para dev containers).
  "name": "HackathonOpenAi",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // Codespaces pide estos secretos al crear el codespace y los expone como variables de entorno.
  // Guárdalos en GitHub → Settings → Codespaces → Secrets. NUNCA en el repo.
  "secrets": {
    "OPENAI_API_KEY": {
      "description": "Llave de la API de OpenAI (platform.openai.com). Se paga aparte de ChatGPT Plus."
    },
    "PEY_API_KEY": {
      "description": "Llave de la API de Pey (portal.mipey.mx → Desarrollador). Solo hay producción: para el hackatón, ligada a la cuenta de prueba de la guía (ver K03.3)."
    },
    "PEY_WEBHOOK_SECRET": {
      "description": "Secreto de firma del webhook de Pey (Standard Webhooks)."
    },
    "CLAUDE_CODE_OAUTH_TOKEN": {
      "description": "Opcional: token de Claude generado con `claude setup-token`."
    }
  },
  "postCreateCommand": "npm install -g @openai/codex vercel && codex --version && vercel --version && node --version",
  // 3000: `vercel dev` o `npx serve app`. Para recibir webhooks de Pey, cambia la visibilidad del puerto a pública.
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "App (vercel dev)" }
  }
}
