# Nombres de las variables de entorno que usa un proyecto de este concurso.
# Los VALORES se guardan como secretos en Vercel, Codespaces o el entorno de Codex. Nunca en el repo.

# OpenAI (platform.openai.com; se paga aparte de ChatGPT Plus).
OPENAI_API_KEY=

# pey (portal de pey → Desarrollador). Solo existe entorno de producción:
# en pruebas se cobran montos de $0.01 a $1 que no se devuelven (ver K03.3 y pey/).
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
