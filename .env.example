# Nombres de las variables de entorno del producto.
# Los VALORES se guardan como secretos en Vercel, Codespaces o el entorno de Codex. Nunca en el repo.

# OpenAI (platform.openai.com; se paga aparte de ChatGPT Plus). Modelo: ver K04.2.
OPENAI_API_KEY=
OPENAI_MODEL=

# Pey (portal.mipey.mx → Desarrollador). Solo existe entorno de producción:
# para el hackatón, liga la llave a la cuenta de prueba de la guía y cobra montos de $0.01 a $1 (ver K03.3).
PEY_API_KEY=
PEY_WEBHOOK_SECRET=

# Reglas del producto
# Tope por cobro en pesos. Para la demo con dinero real basta $1 (pey solo tiene producción, K03.3).
MAX_MONTO_MXN=20
# Secreto para firmar los "tickets" de cobro (texto largo y aleatorio que tú inventas; nunca al repo).
# Si falta, se deriva de PEY_API_KEY; sin ninguna de las dos, solo sirve para SIMULACIÓN.
APP_SECRET=
# Modo de pago que se muestra SIEMPRE en pantalla: simulacion | prueba | comercio
# (prueba = cuenta de prueba de Pey con montos de $0.01 a $1; ver dia-del-evento/RUNBOOK.md)
MODO_PAGO=simulacion
