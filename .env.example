# Nombres de las variables de entorno que usa un proyecto de este concurso.
# Los VALORES se guardan como secretos en Vercel, Codespaces o el entorno de Codex. Nunca en el repo.

# OpenAI (platform.openai.com; se paga aparte de ChatGPT Plus).
OPENAI_API_KEY=

# pey (portal de pey → Desarrollador). Solo existe entorno de producción:
# en pruebas se cobran montos de $0.01 a $1 que no se devuelven (ver K03.3 y pey/).
PEY_API_KEY=
PEY_WEBHOOK_SECRET=

# --- Tócale (opcionales) ---
# Modelo de OpenAI para entender el pedido. Por defecto: gpt-6-luna (developers.openai.com/api/docs/models, 2026-11-07).
OPENAI_MODEL=
# Máximo que el servidor cobra por pedido, en pesos. Por defecto 1 (demo). Tope absoluto en código: 1000.
MONTO_MAXIMO_MXN=
# PIN de caja: si lo defines, solo quien lo sepa puede crear pedidos desde tu despliegue.
CAJA_PIN=
# Secreto para firmar pedidos. Si falta, se deriva de PEY_API_KEY.
FIRMA_SECRETO=
# 1 = forzar SIMULACIÓN aunque haya llave de pey.
MODO_SIMULACION=
