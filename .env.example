# Variables del punto de venta de Tacos El Gran Abanico. Aquí solo van los NOMBRES.
# Los VALORES se guardan como secretos en Vercel (Settings → Environment Variables) o Codespaces. Nunca en el repo.

# --- pey (portal.mipey.mx → Desarrollador). Solo existe producción (pey/02). Sin llave = SIMULACIÓN. ---
PEY_API_KEY=
# Se muestra al crear el webhook (engrane de la llave). URL del webhook: https://<dominio>/api/webhook-pey
PEY_WEBHOOK_SECRET=

# --- Montos ---
# MODO PRUEBA (por defecto): se cobra MONTO_PRUEBA_MXN real en lugar del total. Pon COBRO_PRUEBA=0 para cobrar el total.
COBRO_PRUEBA=
# Pesos. Por defecto 0.10. Nunca más de 1.
MONTO_PRUEBA_MXN=
# Tope por orden con COBRO_PRUEBA=0, en pesos. Por defecto 2000; tope absoluto en código: 5000.
MONTO_MAXIMO_MXN=
# 1 = forzar SIMULACIÓN aunque haya llave de pey.
MODO_SIMULACION=

# --- Supabase (Project Settings → API). Sin estas dos, los datos viven en memoria (solo para pruebas locales). ---
SUPABASE_URL=
# Llave secreta del servidor (service_role o sb_secret_…). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Caja ---
# PIN para entrar a la caja. Obligatorio con cobros reales.
CAJA_PIN=

# --- OpenAI (análisis con IA de ventas e inventario). Opcional: sin llave, el botón dice que está apagado. ---
OPENAI_API_KEY=
# Por defecto gpt-6-luna (developers.openai.com/api/docs/models, consultado 2026-11-07).
OPENAI_MODEL=
